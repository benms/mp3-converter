SOUNDDROP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional; falls back to the platform-provided PORT, then 8000.
SOUNDDROP_PORT=8000
SOUNDDROP_DATA_DIR=/tmp/sounddrop
SOUNDDROP_MAX_DURATION_SECONDS=3600
SOUNDDROP_MAX_SOURCE_MB=256
SOUNDDROP_MAX_STORAGE_MB=1024
SOUNDDROP_JOB_TIMEOUT_SECONDS=1200
SOUNDDROP_FILE_TTL_SECONDS=3600
SOUNDDROP_MAX_QUEUE_SIZE=10
SOUNDDROP_RATE_LIMIT_PER_HOUR=10
# Addresses allowed to supply the client IP via X-Forwarded-For. Rate limits are per client IP:
# if the reverse proxy in front of the server is not trusted here, every visitor shares one limit.
# Local / Docker Compose (no proxy):
SOUNDDROP_FORWARDED_ALLOW_IPS=127.0.0.1
# Render (only its ingress proxy can reach the service):
# SOUNDDROP_FORWARDED_ALLOW_IPS=*
# YouTube often blocks cloud server IPs. Optionally give yt-dlp a cookies.txt from a YouTube
# account (on Render: a Secret File, available at /etc/secrets/<name>) and/or a proxy.
# SOUNDDROP_YTDLP_COOKIES_FILE=/etc/secrets/youtube-cookies.txt
# SOUNDDROP_YTDLP_PROXY=http://user:password@proxy.example:8080
